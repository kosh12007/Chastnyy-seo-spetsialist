# Корректные MIME-типы (лечит ошибку "MIME type application/octet-stream"
# на хостингах, где .js отдаётся как octet-stream)
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Страница ошибки 404: возвращаем честный HTTP-код 404 Not Found вместо Soft 404 (200 OK)
ErrorDocument 404 /404.html
