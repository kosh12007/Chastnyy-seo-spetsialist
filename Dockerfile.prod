# Этап 1: Сборка
FROM node:20-alpine AS builder

WORKDIR /app

# Устанавливаем зависимости
COPY package.json package-lock.json* ./
RUN npm ci --production=false

# Копируем исходники
COPY . .

# Собираем проект
ARG VITE_APP_SITE_URL
ARG VITE_APP_TITLE
ARG VITE_APP_API_URL
ARG VITE_APP_DEFAULT_THEME
ARG VITE_APP_EXPERT_NAME
ARG VITE_APP_EXPERT_FULL_NAME
ARG VITE_APP_EXPERT_FULL_NAME_GENITIVE
ARG VITE_APP_EXPERT_FULL_NAME_INSTRUMENTAL
ARG VITE_APP_EXPERT_FULL_NAME_DATIVE
ARG VITE_APP_EXPERT_INITIALS
ARG VITE_APP_INN
ARG VITE_APP_LEGAL_STATUS_SHORT
ARG VITE_APP_LEGAL_STATUS_FULL
ARG VITE_APP_TAX_REGION
ARG VITE_APP_PHONE
ARG VITE_APP_EMAIL
ARG VITE_APP_WHATSAPP
ARG VITE_APP_TELEGRAM
ARG VITE_APP_ADDRESS
ARG VITE_APP_WORKING_HOURS
ARG VITE_APP_MAP_LATITUDE
ARG VITE_APP_MAP_LONGITUDE

ENV VITE_APP_SITE_URL=${VITE_APP_SITE_URL}
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
ENV VITE_APP_API_URL=${VITE_APP_API_URL}
ENV VITE_APP_DEFAULT_THEME=${VITE_APP_DEFAULT_THEME}
ENV VITE_APP_EXPERT_NAME=${VITE_APP_EXPERT_NAME}
ENV VITE_APP_EXPERT_FULL_NAME=${VITE_APP_EXPERT_FULL_NAME}
ENV VITE_APP_EXPERT_FULL_NAME_GENITIVE=${VITE_APP_EXPERT_FULL_NAME_GENITIVE}
ENV VITE_APP_EXPERT_FULL_NAME_INSTRUMENTAL=${VITE_APP_EXPERT_FULL_NAME_INSTRUMENTAL}
ENV VITE_APP_EXPERT_FULL_NAME_DATIVE=${VITE_APP_EXPERT_FULL_NAME_DATIVE}
ENV VITE_APP_EXPERT_INITIALS=${VITE_APP_EXPERT_INITIALS}
ENV VITE_APP_INN=${VITE_APP_INN}
ENV VITE_APP_LEGAL_STATUS_SHORT=${VITE_APP_LEGAL_STATUS_SHORT}
ENV VITE_APP_LEGAL_STATUS_FULL=${VITE_APP_LEGAL_STATUS_FULL}
ENV VITE_APP_TAX_REGION=${VITE_APP_TAX_REGION}
ENV VITE_APP_PHONE=${VITE_APP_PHONE}
ENV VITE_APP_EMAIL=${VITE_APP_EMAIL}
ENV VITE_APP_WHATSAPP=${VITE_APP_WHATSAPP}
ENV VITE_APP_TELEGRAM=${VITE_APP_TELEGRAM}
ENV VITE_APP_ADDRESS=${VITE_APP_ADDRESS}
ENV VITE_APP_WORKING_HOURS=${VITE_APP_WORKING_HOURS}
ENV VITE_APP_MAP_LATITUDE=${VITE_APP_MAP_LATITUDE}
ENV VITE_APP_MAP_LONGITUDE=${VITE_APP_MAP_LONGITUDE}

RUN npm run build

# Этап 2: Production image (только dist)
FROM node:20-alpine AS prod

WORKDIR /app

# Копируем собранные файлы
COPY --from=builder /app/dist ./dist

# Устанавливаем простой HTTP сервер для отдачи статики
RUN npm install -g serve

EXPOSE 3000

# Запускаем без флага -s (--single), чтобы несуществующие URL и файлы возвращали 404 Not Found (dist/404.html), а не 200 OK
CMD ["serve", "dist", "-l", "3000"]
